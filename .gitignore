# Go
bin/
*.test
*.out
/apps/*/server

# Node
apps/*/web/node_modules
apps/*/web/.vite
apps/*/node_modules

# Built SPA artefacts. Vite overwrites web/dist on every build.
# Keep the placeholder index.html in source control so `go build`
# works before the first build. Ignore the rest.
apps/*/web/dist/*
!apps/*/web/dist/index.html

# apps/node builds to dist/ via tsc; nothing needs it in source control.
apps/node/dist

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# TypeScript incremental build state.
apps/*/web/tsconfig.tsbuildinfo
apps/*/tsconfig.tsbuildinfo
